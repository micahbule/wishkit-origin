{
  // Root config so a bare `tsc --noEmit` type-checks the whole project.
  // App sources use tsconfig.app.json; Vite/Svelte config files use tsconfig.node.json.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "data/**/*.json", "vite.config.ts", "svelte.config.js"]
}
